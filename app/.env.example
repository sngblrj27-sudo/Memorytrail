# Create .env locally or set these as server-side hosting secrets. Never paste provider keys into a public browser app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional for local; recommended for the small reviewer pilot. Share with reviewers separately.
REVIEWER_TOKEN=
# Only enable after implementing hosting-level rate limits and spending controls.
ALLOW_PUBLIC_AI=false
PORT=3000
